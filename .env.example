# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# MONGODB_URI: MongoDB Atlas connection string for Clestra serverless offline relay
# Configured via AI Studio Secrets panel or local environment
MONGODB_URI="mongodb://localhost:27017/clestra_relay"

# OPENROUTER_API_KEY: Required for Clestra official assistant via OpenRouter
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
