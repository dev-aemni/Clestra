# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# MONGODB_URI: MongoDB Atlas connection string for Clestra serverless offline relay
# Configured via AI Studio Secrets panel or local environment
MONGODB_URI="mongodb://localhost:27017/clestra_relay"

# OPENROUTER_API_KEY: Required for Clestra official assistant via OpenRouter
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# GIPHY_API_KEY: API key for GIPHY GIF search and trending (https://developers.giphy.com)
GIPHY_API_KEY=MY_GIPHY_API_KEY

# TENOR_API_KEY: API key for Tenor GIF search and featured GIFs (https://developers.google.com/tenor)
TENOR_API_KEY=MY_TENOR_API_KEY

# KLIPY_API_KEY: Optional API key for KLIPY GIF search and trending (https://partner.klipy.com)
KLIPY_API_KEY=MY_KLIPY_API_KEY
